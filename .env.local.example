NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# No NEXT_PUBLIC_ prefix — this one must stay server-only and never reach the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe (invoicing & payments) — both server-only, never expose to the browser.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Supabase SECRET key (not the publishable one above) — server-only. Used
# exclusively by the Stripe webhook route, which has no user session to
# authenticate as and needs this to mark an invoice paid. Never add a
# NEXT_PUBLIC_ prefix to this.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
