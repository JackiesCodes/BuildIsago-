NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# No NEXT_PUBLIC_ prefix — this one must stay server-only and never reach the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe (invoicing & payments) — both server-only, never expose to the browser.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Supabase SECRET key (not the publishable one above) — server-only. Used by
# the Stripe webhook route (no user session to authenticate as when marking
# an invoice paid) and by email notifications below (to look up another
# user's email address). Never add a NEXT_PUBLIC_ prefix to this.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Email notifications (new message, invoice sent/paid, approval
# requested/decided, new project) — server-only. Get a key at
# https://resend.com/api-keys. NOTIFICATIONS_FROM_EMAIL is optional and
# defaults to Resend's sandbox sender, which can only deliver to the email
# address you signed up to Resend with until you verify a sending domain.
RESEND_API_KEY=re_your-resend-api-key
NOTIFICATIONS_FROM_EMAIL=BuildIsago <notifications@yourdomain.com>

# Used to build absolute URLs in sitemap.xml, robots.txt, and Open Graph
# metadata. Defaults to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://build-isago.vercel.app
